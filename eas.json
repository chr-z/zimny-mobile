{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest",
        "credentialsSource": "local"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "<YOUR_APPLE_TEAM_ID>",
        "ascAppId": "<YOUR_ASC_APP_ID>",
        "ascApiKeyPath": "ios/credentials/AuthKey_XXXXXXXXXX.p8",
        "ascApiKeyId": "<YOUR_ASC_KEY_ID>",
        "ascApiKeyIssuerId": "<YOUR_ASC_ISSUER_ID>"
      },
      "android": {
        "serviceAccountKeyPath": "../your-play-service-account.json"
      }
    }
  }
}
